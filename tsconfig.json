{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    // JSX
    "jsx": "react-jsx",
    // Strictness
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Module interop
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    // Output (Vite handles bundling, but tsc can still type-check)
    "noEmit": true
  },
  "include": [
    "src/**/*"
  ]
}